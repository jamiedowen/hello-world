<?xml version="1.0" encoding="UTF-8"?>

<!-- Android build of Midnight 84 (standalone app). The VST3 / AU / desktop builds use ../CMakeLists.txt.
     Generate the Android Studio project with:  Projucer --resave android/Midnight84.jucer
     (expects a JUCE 8.0.4 checkout at ../JUCE). See .github/workflows/build.yml. -->
<JUCERPROJECT id="M84anD" name="Midnight84" projectType="audioplug" version="1.0.0"
              bundleIdentifier="com.midnightaudio.midnight84" companyName="Midnight Audio"
              pluginName="Midnight 84" pluginDesc="Polyphonic darkwave synth" pluginManufacturer="Midnight Audio"
              pluginManufacturerCode="Mdna" pluginCode="Mn84" pluginChannelConfigs=""
              pluginFormats="buildStandalone" pluginCharacteristicsValue="pluginIsSynth,pluginWantsMidiIn"
              cppLanguageStandard="17" useAppConfig="1" addUsingNamespaceToJuceHeader="0"
              displaySplashScreen="0" jucerFormatVersion="1">
  <MAINGROUP id="M84grp" name="Midnight84">
    <GROUP id="M84src" name="Source">
      <FILE id="Us6XcF" name="Arpeggiator.cpp" compile="1" resource="0" file="../Source/Arpeggiator.cpp"/>
      <FILE id="aHQu1m" name="Arpeggiator.h" compile="0" resource="0" file="../Source/Arpeggiator.h"/>
      <FILE id="DF2JWV" name="Components.cpp" compile="1" resource="0" file="../Source/Components.cpp"/>
      <FILE id="xMjI8W" name="Components.h" compile="0" resource="0" file="../Source/Components.h"/>
      <FILE id="TqHDz5" name="DSP.h" compile="0" resource="0" file="../Source/DSP.h"/>
      <FILE id="5UvMoi" name="Effects.cpp" compile="1" resource="0" file="../Source/Effects.cpp"/>
      <FILE id="Q8EcGZ" name="Effects.h" compile="0" resource="0" file="../Source/Effects.h"/>
      <FILE id="cjcFHR" name="LookAndFeel.cpp" compile="1" resource="0" file="../Source/LookAndFeel.cpp"/>
      <FILE id="sIgapm" name="LookAndFeel.h" compile="0" resource="0" file="../Source/LookAndFeel.h"/>
      <FILE id="5BisTh" name="Parameters.cpp" compile="1" resource="0" file="../Source/Parameters.cpp"/>
      <FILE id="rh6UgI" name="Parameters.h" compile="0" resource="0" file="../Source/Parameters.h"/>
      <FILE id="eDJbjW" name="PluginEditor.cpp" compile="1" resource="0" file="../Source/PluginEditor.cpp"/>
      <FILE id="XYUTEb" name="PluginEditor.h" compile="0" resource="0" file="../Source/PluginEditor.h"/>
      <FILE id="TMOPi4" name="PluginProcessor.cpp" compile="1" resource="0" file="../Source/PluginProcessor.cpp"/>
      <FILE id="JMN7mk" name="PluginProcessor.h" compile="0" resource="0" file="../Source/PluginProcessor.h"/>
      <FILE id="qlu4xI" name="Presets.cpp" compile="1" resource="0" file="../Source/Presets.cpp"/>
      <FILE id="tj9Z4F" name="Presets.h" compile="0" resource="0" file="../Source/Presets.h"/>
      <FILE id="BlJ6P2" name="SynthEngine.cpp" compile="1" resource="0" file="../Source/SynthEngine.cpp"/>
      <FILE id="Ob30ea" name="SynthEngine.h" compile="0" resource="0" file="../Source/SynthEngine.h"/>
    </GROUP>
  </MAINGROUP>
  <EXPORTFORMATS>
    <ANDROIDSTUDIO targetFolder="Builds/Android" androidMinimumSDK="26" androidTargetSDK="34"
                   androidScreenOrientation="landscape" microphonePermissionNeeded="0"
                   androidBluetoothConnectNeeded="1" androidBluetoothScanNeeded="1"
                   androidVersionCode="1">
      <CONFIGURATIONS>
        <CONFIGURATION name="Debug" isDebug="1" optimisation="1" targetName="Midnight84"
                       androidArchitectures="arm64-v8a"/>
        <CONFIGURATION name="Release" isDebug="0" optimisation="3" linkTimeOptimisation="0"
                       targetName="Midnight84" androidArchitectures="arm64-v8a armeabi-v7a"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path="../JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices" path="../JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats" path="../JUCE/modules"/>
        <MODULEPATH id="juce_audio_plugin_client" path="../JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors" path="../JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils" path="../JUCE/modules"/>
        <MODULEPATH id="juce_core" path="../JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="../JUCE/modules"/>
        <MODULEPATH id="juce_dsp" path="../JUCE/modules"/>
        <MODULEPATH id="juce_events" path="../JUCE/modules"/>
        <MODULEPATH id="juce_graphics" path="../JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics" path="../JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra" path="../JUCE/modules"/>
      </MODULEPATHS>
    </ANDROIDSTUDIO>
  </EXPORTFORMATS>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_plugin_client" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_utils" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_dsp" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
  </MODULES>
  <JUCEOPTIONS JUCE_WEB_BROWSER="0" JUCE_USE_CURL="0" JUCE_VST3_CAN_REPLACE_VST2="0"/>
  <LIVE_SETTINGS/>
</JUCERPROJECT>

{
  "name": "procountdown",
  "version": "1.0.0",
  "description": "Professional broadcast-quality countdown timer for live events",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "keywords": ["countdown", "timer", "broadcast", "electron"],
  "author": "ProCountdown",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.procountdown.timer",
    "productName": "ProCountdown",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ProCountdown.exe"
    }
  }
}
